GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-flash
PROVIDER_TIMEOUT_MS=60000
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=256
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_TEMPERATURE=0.7
CACHE_MATCH_MODE=exact
EVALUATION_RUBRIC=legacy-v1
# Keep local mode for localhost development. Use deploy.configure for hosting.
DEPLOYMENT_MODE=local
API_ACCESS_TOKEN=
GATEWAY_SECRET=
API_REQUESTS_PER_MINUTE=30
PROVIDER_CALLS_PER_DAY=200
PROVIDER_MAX_CONCURRENT=2
# Optional absolute paths: REPORTS_DIR and STATE_DIR
